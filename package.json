    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "autoprefixer": "^10.5.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.74.0",
